# Minimal allowlist: exclude everything, then re-include only what the
# inference image needs. Raw data, notebooks, tests and train.py never enter
# the build context.
*
!requirements.txt
!features.py
!predict.py
!api.py
!model.joblib
!app
!src/
src/*
!src/rent_domain/
src/rent_domain/*
!src/rent_domain/__init__.py
!src/rent_domain/apartment.py
