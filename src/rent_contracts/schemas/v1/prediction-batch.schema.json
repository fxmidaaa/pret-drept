{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rent:prediction-batch:1.0.0",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "bundle_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}"
    },
    "target_unit": {
      "const": "EUR/month"
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9]",
            "not": {
              "pattern": "[^A-Za-z0-9_.-]"
            }
          },
          "predicted_rent_eur": {
            "type": "number"
          }
        },
        "required": [
          "record_id",
          "predicted_rent_eur"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "bundle_digest",
    "target_unit",
    "predictions"
  ],
  "additionalProperties": false
}
