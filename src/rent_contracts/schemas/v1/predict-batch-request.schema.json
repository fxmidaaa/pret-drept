{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rent:predict-batch-request:1.0.0",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "bundle_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[a-f0-9]{64}"
        }
      },
      "required": [
        "path",
        "digest"
      ],
      "additionalProperties": false
    },
    "input_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "input_schema_version": {
      "const": "1.0.0"
    },
    "inference_configuration": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "output_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": [
    "contract_version",
    "bundle_ref",
    "input_path",
    "input_schema_version",
    "inference_configuration",
    "output_path"
  ],
  "additionalProperties": false
}
