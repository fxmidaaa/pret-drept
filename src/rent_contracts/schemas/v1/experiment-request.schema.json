{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rent:experiment-request:1.0.0",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "task_ref": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9]",
      "not": {
        "pattern": "[^A-Za-z0-9_.-]"
      }
    },
    "operation": {
      "const": "train"
    },
    "code_snapshot_ref": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}"
    },
    "dataset_ref": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}"
    },
    "split_ref": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}"
    },
    "model_family": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9]",
      "not": {
        "pattern": "[^A-Za-z0-9_.-]"
      }
    },
    "configuration": {
      "type": "object"
    },
    "resource_profile": {
      "type": "object",
      "properties": {
        "cpu_count": {
          "type": "integer",
          "minimum": 1
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 1
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "gpu_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "cpu_count",
        "memory_mib",
        "duration_seconds",
        "gpu_count"
      ],
      "additionalProperties": false
    },
    "idempotency_key": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9]",
      "not": {
        "pattern": "[^A-Za-z0-9_.-]"
      }
    },
    "random_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "required": [
    "contract_version",
    "task_ref",
    "operation",
    "code_snapshot_ref",
    "dataset_ref",
    "split_ref",
    "model_family",
    "configuration",
    "resource_profile",
    "idempotency_key",
    "random_seed"
  ],
  "additionalProperties": false
}
