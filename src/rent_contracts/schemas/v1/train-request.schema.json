{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rent:train-request:1.0.0",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "model_family": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "configuration": {
      "type": "object"
    },
    "training_partition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "validation_partition": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "dataset_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "split_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "random_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "checkpoint_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "output_directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": [
    "contract_version",
    "model_family",
    "configuration",
    "training_partition",
    "validation_partition",
    "dataset_ref",
    "split_ref",
    "random_seed",
    "checkpoint_ref",
    "output_directory"
  ],
  "additionalProperties": false
}
