# Reset setuptools' implicit test selection before declaring the release payload.
global-exclude *
include LICENSE MANIFEST.in README.md pyproject.toml
recursive-include src/rent_agent *.py
recursive-include src/rent_checks *.py
recursive-include src/rent_contracts *.py
recursive-include src/rent_data *.py
recursive-include src/rent_domain *.py
recursive-include src/rent_prediction *.py
include src/rent_contracts/schemas/v1/*.json
include tests/foundations/conftest.py
include tests/foundations/test_architecture.py
include tests/foundations/test_contracts.py
include tests/foundations/test_predictions_bundles.py
include tests/foundations/test_evaluation_contracts.py
include tests/foundations/test_observation_candidates.py
include tests/foundations/test_tasks.py
