# Copy to .env, then load from the project root: set -a; source .env; set +a
# Local paths refer to this project. Docker has its own /models/model.joblib default.
PRET_DREPT_MODEL=artifacts/real/model.joblib
DVC_NO_ANALYTICS=true
MLFLOW_DISABLE_TELEMETRY=true

# Optional override for a saved TabPFN predictor: auto, cpu, or mps.
# PRET_DREPT_TABPFN_DEVICE=auto
